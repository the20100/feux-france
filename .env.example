# Copier ce fichier en .env et renseigner les clés.
# Toutes les clés sont facultatives : chaque fonctionnalité se désactive
# proprement si sa clé est absente.

# Recherche de sources ouvertes (presse, social, état, vidéos) — https://exa.ai
EXA_API_KEY=

# Synthèses IA par foyer — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-nano

# Météo-France (danger forêts, vigilance, observations) —
# https://portail-api.meteofrance.fr : souscrire aux APIs puis générer un token
# d'application. UN SEUL token suffit (il couvre toutes les souscriptions) :
# renseigner le même dans chaque variable, ou seulement MF_TOKEN_OBS.
MF_TOKEN_OBS=
MF_TOKEN_VIGILANCE=
MF_TOKEN_FORETS=
MF_TOKEN_RADAR=
MF_TOKEN_CLIMAT=
MF_TOKEN_AROME=
MF_TOKEN_AROME_IF=

# Trajectoires complètes des bombardiers d'eau — https://opensky-network.org
# (compte gratuit, identifiants API OAuth2)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
