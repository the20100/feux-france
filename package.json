{
  "name": "omni-control",
  "version": "1.0.0",
  "private": true,
  "description": "OMNI — observatoire géospatial FEUX, PANDEMIC et WAR, historique et sources.",
  "scripts": {
    "dev": "next dev -p 8742",
    "build": "next build",
    "start": "next start -p 8742",
    "update": "node scripts/update.mjs",
    "typecheck": "tsc --noEmit",
    "omni:sync": "node scripts/omni-worker.mjs",
    "omni:worker": "node scripts/omni-worker.mjs --daemon",
    "omni:import": "node scripts/omni-import.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test tests/*.test.mjs",
    "parliament:build": "node scripts/parliament-build.mjs && node --max-old-space-size=6000 scripts/parliament-extra.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.11.2",
    "leaflet": "^1.9.4",
    "leaflet-velocity": "^2.1.4",
    "leaflet.heat": "^0.2.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
