{
  "name": "omni-control",
  "version": "1.0.0",
  "private": true,
  "description": "OMNI \u2014 observatoire g\u00e9ospatial FEUX, PANDEMIC et WAR, historique et sources.",
  "scripts": {
    "dev": "next dev -p 8742",
    "build": "next build",
    "start": "next start -p 8742",
    "update": "node scripts/update.mjs",
    "typecheck": "tsc --noEmit",
    "omni:sync": "node scripts/omni-worker.mjs",
    "omni:worker": "node scripts/omni-worker.mjs --daemon",
